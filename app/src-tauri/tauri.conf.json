{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aerial Stitch",
  "version": "0.1.0",
  "identifier": "com.johnstonmedia.aerialstitch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aerial Stitch",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: tiles: http://tiles.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Stitch drone photos into maps, entirely on your computer",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
